# HubSpot Forms API. Optional: the public IDs are already defaults in src/lib/hubspot.ts;
# set these (in .env.local or Vercel) only to override them.
# Portal ID is shared by all the forms.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
# HubSpot data-hosting region (default "eu1", the EU data centre).
NEXT_PUBLIC_HUBSPOT_REGION=
# "Request a demo" modal form
NEXT_PUBLIC_HUBSPOT_DEMO_FORM_ID=
# "Contact us" form on /contact (the "Request a tailored quote" pop-up on /pricing submits
# to this form too, by agreement with the HubSpot admin)
NEXT_PUBLIC_HUBSPOT_CONTACT_FORM_ID=
# "Request Money Masters" pop-up (/money-masters and /resources). Not created yet.
NEXT_PUBLIC_HUBSPOT_MONEY_MASTERS_FORM_ID=
# ROAR sign-up form on /roar (default: the form embedded on the old ROAR 2026 page)
NEXT_PUBLIC_HUBSPOT_ROAR_FORM_ID=
# Resource downloads: the Future Jobs Kit 2.0 and My First Job Kit pop-up on /resources and the
# First CV Workshop form on /cv-workshop (default: the resources form)
NEXT_PUBLIC_HUBSPOT_RESOURCES_FORM_ID=

# Google Analytics 4 (optional overrides). The public default ID lives in src/lib/analytics.ts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Set to "true" to switch analytics off (e.g. on a staging deployment).
NEXT_PUBLIC_DISABLE_ANALYTICS=
