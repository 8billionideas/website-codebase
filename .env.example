# HubSpot Forms API. Copy to .env.local and fill in.
# Portal ID is shared by all the forms.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
# HubSpot data-hosting region: "eu1" for EU accounts, empty for the standard (US) region.
NEXT_PUBLIC_HUBSPOT_REGION=
# "Request a demo" modal form
NEXT_PUBLIC_HUBSPOT_DEMO_FORM_ID=
# "Contact us" form on /contact
NEXT_PUBLIC_HUBSPOT_CONTACT_FORM_ID=
# "Request a tailored quote" pop-up on /pricing
NEXT_PUBLIC_HUBSPOT_QUOTE_FORM_ID=
